# Safety-Judge Robustness — API keys and provider config
# Copy this to .env and fill in your credentials:
#   cp .env.example .env
#   export $(grep -v '^#' .env | grep -v '^$' | xargs)
#
# Only the API/HF judges need keys. The `rulebased` judge (default, smoke test) needs none.

# OpenAI — powers the gpt4o and strongreject rubric judges
OPENAI_API_KEY=sk-...

# OpenRouter — serves Llama Guard 3 8B (and many models) via an OpenAI-compatible API.
# Get a key at https://openrouter.ai/keys (you must add credits; usage for this run is cents).
# This is all you need to run the `llamaguard_or` judge — no GPU, no HF login.
OPENROUTER_API_KEY=sk-or-...

# HuggingFace — only if running guard models LOCALLY on a GPU (llamaguard/shieldgemma/wildguard).
# Not needed if you use OPENROUTER_API_KEY above. Run `huggingface-cli login` or set the token.
HF_TOKEN=hf_...

# Optional: route llamaguard through an OpenAI-compatible host (e.g. Together) instead of local GPU
# LLAMAGUARD_BASE_URL=https://api.together.xyz/v1
# LLAMAGUARD_API_KEY=...
